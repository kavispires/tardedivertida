# Function to increment the patch version in the game-info.json file
# Accepts one argument: the path to the game-info.json file
function increment_patch_version {
   # Read the current version from the file
    current_version=$(awk -F'"' '/version/ {print $4}' "$1")

    if ! [[ $current_version =~ [0-9] ]]; then
        echo "    🔘 This game is in a pre-release version."
        return 0
    fi

    # Split the version string into its components
    IFS='.' read -ra version_parts <<< "$current_version"

    # Increment the patch position of the version
    new_patch=$((version_parts[2] + 1))
    new_version="${version_parts[0]}.${version_parts[1]}.$new_patch"

    # Replace the version property in the file with the new version
    sed -i.bak "s/\"version\": \"$current_version\"/\"version\": \"$new_version\"/" "$1"

    # Clean up the backup file created by sed
    rm "$1.bak"

    # Print the new version
    echo "    ☑️  Auto-incrementing patch version: $current_version to $new_version."
}

# Update the game timestamp in milliseconds without reformatting the JSON file
# Accepts one argument: the path to the game-info.json file
function update_game_timestamp {
  local updated_at
  if ! updated_at=$(node -e '
    const fs = require("node:fs");
    const filePath = process.argv[1];
    const timestamp = Date.now();
    let contents = fs.readFileSync(filePath, "utf8");

    if (/"updatedAt"\s*:\s*\d+/.test(contents)) {
      contents = contents.replace(/"updatedAt"\s*:\s*\d+/, `"updatedAt": ${timestamp}`);
    } else {
      const releaseDatePattern = /^(\s*)"releaseDate"\s*:\s*"[^"]+",\r?\n/m;

      if (!releaseDatePattern.test(contents)) {
        throw new Error(`Could not find releaseDate in ${filePath}`);
      }

      contents = contents.replace(
        releaseDatePattern,
        (releaseDate, indentation) => `${releaseDate}${indentation}"updatedAt": ${timestamp},\n`,
      );
    }

    fs.writeFileSync(filePath, contents);
    console.log(timestamp);
  ' "$1"); then
    echo "    ❌ Failed to update timestamp in $1."
    return 1
  fi

  echo "    ☑️  Updated timestamp: ${updated_at}."
}

# Check whether a game path contains staged changes other than metadata files
# Accepts one argument: a client or Functions game directory
function has_meaningful_game_changes {
  git diff --cached --name-only HEAD -- "$1" \
    | grep -Ev '(^|/)(metadata\.md|game-info\.json)$' \
    | grep -q .
}

function update_package_version {
  # Get the current version from package.json
  current_version=$(awk -F'"' '/version/ {print $4}' package.json)

  # Check if the version property has been modified in staged changes
  if git diff --cached package.json | grep -q '^\+.*"version"'; then
      echo "☑️  tarde-divertida version was already updated: ${current_version}"
  else
      # Always increment the patch version
      yarn version --patch --no-git-tag-version

      git add package.json

      # Get the new version from package.json
      new_version=$(awk -F'"' '/version/ {print $4}' package.json)

      echo "☑️  tarde-divertida version updated: from ${current_version} to ${new_version}"
  fi
}


check_game_versions() {
  echo "🔎 Verifying Games versioning"
  local modified_game_count=0
  for game_dir in src/games/*; do
    if [ -d "${game_dir}" ]; then
      if [ "$(ls -A "${game_dir}")" ]; then
        local was_modified=false
        # Check if any files other than metadata have been modified
        if has_meaningful_game_changes "${game_dir}"; then
          echo "  ⏩ Files in ${game_dir} have been modified since the last commit."
          was_modified=true
        fi

        game_name=$(basename "$game_dir")
        engine_dir="functions/src/games/$game_name"

        if has_meaningful_game_changes "${engine_dir}"; then
          echo "  ⏩ Files in ${engine_dir} have been modified since the last commit."
          was_modified=true
        fi

        if $was_modified; then
          modified_game_count=$((modified_game_count+1))
          # Check if the version property has been modified in staged changes
          if git diff --cached -- "${game_dir}/game-info.json" | grep -q '^\+.*"version"'; then
            echo "    ☑️ The version was already updated."
          else
            increment_patch_version "${game_dir}/game-info.json"
          fi
          update_game_timestamp "${game_dir}/game-info.json"
          git add "${game_dir}/game-info.json"
        fi
      fi
    fi
  done

  echo "${modified_game_count} games modified"

  # Only update package version if it's a new commit
  if ! git reflog -1 | grep -q -- amend; then
    update_package_version "${modified_game_count}"
  fi

  echo "✅ Done"
}

sort_imports() {
  echo "♻️ Sorting ui imports"
  local files_to_format=""
  # Find and sort the imports in .ts and .tsx files, then re-add them to the staging area
  local staged_files=$(git diff --name-only --cached | grep -E '^src/.*\.(ts|tsx)$')

  for file in $staged_files; do
    if git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
      node ./scripts/sort-imports.cjs "$file"
      git add "$file"
      echo "   ➕ Sorted and re-added $file to staging."
      files_to_format="$files_to_format $file"
    else
      echo "   ➖ Skipping deleted file: $file"
    fi
  done

  echo "✅ Done"
}

sort_functions_imports() {
  echo "♻️ Sorting functions imports"
  # Find and sort the imports in .ts and .tsx files in functions/src, then re-add them to the staging area
  local staged_files=$(git diff --name-only --cached | grep -E '^functions/src/.*\.(ts|tsx)$')

  for file in $staged_files; do
    if git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
      node ./scripts/sort-functions-imports.cjs "$file"
      git add "$file"
      echo "   ➕ Sorted and re-added $file to staging."
    else
      echo "   ➖ Skipping deleted file: $file"
    fi
  done

  echo "✅ Done"
}

lint_staged_files() {
  echo "🔎 Linting staged files"
  # Run biome on all staged files
  local staged_files=$(git diff --name-only --cached | grep -E '.*\.(ts|tsx)$')

  if [ -n "$staged_files" ]; then
    yarn biome check --staged --write --no-errors-on-unmatched $staged_files

    # Only add files that still exist (filter out deleted files)
    for file in $staged_files; do
      if git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
        git add "$file"
        echo "   ➕ Re-added $file to staging."
      else
        echo "   ➖ Skipping deleted file: $file"
      fi
    done

    echo "   ✨ Biome formatting applied to all staged files"
  else
    echo "   ➖ No staged .ts or .tsx files to lint."
  fi

  echo "✅ Done"
}

sort_functions_imports
sort_imports
lint_staged_files
check_game_versions
