		"deploy": "gh-pages -d build",
		"lint": "biome check . --write --no-errors-on-unmatched",
		"check:icons": "node scripts/check-icon-imports.cjs",
		"scripts:list": "node scripts/list-scripts.cjs",
		"prepare": "husky",
