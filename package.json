		"sort-imports": "node scripts/sort-imports-in-folder.cjs",
		"sort-functions-imports": "node scripts/sort-functions-imports-in-folder.cjs",
		"revert-versions": "node scripts/revert-game-versions.cjs",
		"sync:types": "curl -s https://raw.githubusercontent.com/kavispires/td-resources/main/types/tdr.ts | tee src/types/tdr.ts functions/src/types/tdr.ts > /dev/null",
		"predev": "npm run sync:types",
		"clean": "rm -rf node_modules & yarn cache clean"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
