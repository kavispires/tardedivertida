{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "gameCode": { "type": "string" },
    "gameName": { "type": "string" },
    "version": { "type": "string" },
    "release": {
      "type": "string",
      "enum": ["dev", "beta", "stable", "planned", "cancelled", "deprecated", "paused"]
    },
    "releaseDate": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|0000-00-00)$"
    },
    "available": { "type": "boolean" },
    "title": {
      "type": "object",
      "properties": {
        "pt": { "type": "string" },
        "en": { "type": "string" }
      },
      "required": ["pt", "en"]
    },
    "popularName": {
      "type": "object",
      "properties": {
        "pt": { "type": "string" },
        "en": { "type": "string" }
      },
      "required": ["pt", "en"]
    },
    "inspiredBy": { "type": "string" },
    "summary": {
      "type": "object",
      "properties": {
        "pt": { "type": "string" },
        "en": { "type": "string" }
      },
      "required": ["pt", "en"]
    },
    "appearance": {
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string" },
        "surfaceColor": { "type": "string" },
        "colorScheme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "clouds": { "type": "string" },
        "cloudsAnimationType": {
          "type": "string",
          "enum": ["flow", "rising", "falling"]
        },
        "videoBackground": { "type": "boolean" },
        "imageBackground": { "type": "boolean" }
      },
      "required": ["primaryColor", "clouds", "cloudsAnimationType", "colorScheme", "videoBackground"]
    },
    "rules": {
      "type": "object",
      "properties": {
        "pt": {
          "type": "array",
          "items": { "type": "string" }
        },
        "en": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["pt", "en"]
    },
    "playerCount": {
      "type": "object",
      "properties": {
        "best": { "type": "integer" },
        "recommended": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      },
      "required": ["recommended", "min", "max", "best"]
    },
    "duration": {
      "type": "object",
      "properties": {
        "base": { "type": "number" },
        "perPlayer": { "type": "number" }
      },
      "required": ["base", "perPlayer"]
    },
    "mechanics": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "competitive",
          "cooperative",
          "same-time",
          "turn-based",
          "drawing",
          "writing",
          "guessing",
          "voting",
          "pairing",
          "push-your-luck",
          "brain-burner",
          "discussion",
          "puzzle",
          "timed",
          "images",
          "betting",
          "traitor"
        ]
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["achievements", "audience", "bots", "mobile-friendly", "player-drop", "sound-effects"]
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "disabled": { "type": "boolean" },
          "kind": {
            "type": "string",
            "enum": ["switch", "checkbox", "radio"]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "value": {
                  "type": ["string", "boolean"]
                }
              },
              "required": ["label", "value"]
            },
            "minItems": 1
          }
        },
        "required": ["key", "label", "kind", "description"]
      }
    }
  },
  "required": [
    "gameCode",
    "gameName",
    "version",
    "release",
    "releaseDate",
    "available",
    "title",
    "popularName",
    "inspiredBy",
    "summary",
    "rules",
    "playerCount",
    "mechanics",
    "appearance",
    "duration",
    "features"
  ]
}
